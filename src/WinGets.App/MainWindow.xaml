<Window
    x:Class="WinGets.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="WinGets">

    <Grid Background="{ThemeResource PageBackgroundBrush}" Padding="20">
        <Border Background="{ThemeResource CardBackgroundBrush}"
                BorderBrush="{ThemeResource CardStrokeBrush}"
                BorderThickness="1"
                CornerRadius="28">
            <NavigationView x:Name="ShellNavigation"
                            PaneDisplayMode="LeftCompact"
                            IsBackButtonVisible="Collapsed"
                            IsSettingsVisible="False"
                            SelectionChanged="ShellNavigation_SelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="Dashboard" Icon="Home" Tag="Dashboard" IsSelected="True" />
                    <NavigationViewItem Content="Modules" Icon="Library" Tag="Modules" />
                    <NavigationViewItem Content="Events" Icon="Calendar" Tag="Events" />
                    <NavigationViewItem Content="Zen" Icon="Favorite" Tag="Zen" />
                    <NavigationViewItem Content="Settings" Icon="Setting" Tag="Settings" />
                </NavigationView.MenuItems>
                <Frame x:Name="ContentFrame" Padding="12" />
            </NavigationView>
        </Border>
    </Grid>
</Window>
