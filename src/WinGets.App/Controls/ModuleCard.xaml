<UserControl
    x:Class="WinGets.App.Controls.ModuleCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Button Command="{x:Bind CardCommand, Mode=OneWay}" CommandParameter="{x:Bind Module, Mode=OneWay}" Padding="0" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0">
        <Border Style="{StaticResource CalmCardStyle}" Padding="0" MinWidth="240">
            <Grid ColumnDefinitions="8,*">
                <Border Background="{x:Bind AccentBrush, Mode=OneWay}" CornerRadius="28,0,0,28" />
                <StackPanel Grid.Column="1" Spacing="12" Padding="22">
                    <TextBlock Text="{x:Bind Module.Name, Mode=OneWay}" Style="{StaticResource SubtitleTextStyle}" />
                    <TextBlock Text="{x:Bind Module.ChecklistSummary, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
                    <ProgressBar Value="{x:Bind Module.EffectiveProgress, Mode=OneWay}" Maximum="100" />
                    <TextBlock Text="{x:Bind ProgressLabel, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Button>
</UserControl>
