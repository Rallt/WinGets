<UserControl
    x:Class="WinGets.App.Controls.EventCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Style="{StaticResource PillCardStyle}" Background="{x:Bind CardBrush, Mode=OneWay}">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
            <TextBlock Text="{x:Bind EventData.Title, Mode=OneWay}" Style="{StaticResource SubtitleTextStyle}" />
            <TextBlock Grid.Column="1" Text="{x:Bind EventData.EventType, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
            <TextBlock Grid.Row="1" Text="{x:Bind ModuleName, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" />
            <TextBlock Grid.Row="2" Text="{x:Bind EventData.DateLabel, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="Urgent" Visibility="{x:Bind UrgencyVisibility, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
        </Grid>
    </Border>
</UserControl>
