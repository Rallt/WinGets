<Page
    x:Class="WinGets.App.Views.ZenPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="42" Background="{ThemeResource PageBackgroundBrush}">
        <Border Style="{StaticResource CalmCardStyle}" Background="{ThemeResource PastelMintBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="42">
            <StackPanel Spacing="28" HorizontalAlignment="Center" MaxWidth="720">
                <TextBlock Text="Zen Mode" Style="{StaticResource TitleTextStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding TodayFocusModule.Name, FallbackValue=Choose one gentle task}" FontFamily="Segoe UI Variable" FontSize="48" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="{Binding TodayFocusTask.Title, FallbackValue=Breathe and begin with one small action}" Style="{StaticResource SubtitleTextStyle}" TextAlignment="Center" />
                <TextBlock Text="{Binding AutomationSummary}" Style="{StaticResource CaptionTextStyle}" TextAlignment="Center" />
                <TextBlock Text="{Binding ZenTimerState}" Style="{StaticResource BodyTextStyle}" HorizontalAlignment="Center" />
                <ProgressBar Value="{Binding TodayFocusModule.EffectiveProgress}" Maximum="100" Width="420" />
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                    <Button Content="Start focus" Command="{Binding StartPomodoroCommand}" />
                    <Button Content="Complete task" Command="{Binding CompleteFocusTaskCommand}" />
                    <Button Content="Reset timer" Command="{Binding ResetZenTimerCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
