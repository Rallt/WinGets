<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ThemeShadow x:Key="CardThemeShadow" />

    <Style TargetType="Button">
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="FontFamily" Value="Segoe UI Variable" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="FontFamily" Value="Segoe UI Variable" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="FontFamily" Value="Segoe UI Variable" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="MinHeight" Value="10" />
        <Setter Property="Foreground" Value="{ThemeResource PastelBlueBrush}" />
        <Setter Property="Background" Value="{ThemeResource CardStrokeBrush}" />
    </Style>

    <Style x:Key="CalmCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Shadow" Value="{StaticResource CardThemeShadow}" />
        <Setter Property="Translation" Value="0,0,12" />
    </Style>

    <Style x:Key="PillCardStyle" TargetType="Border" BasedOn="{StaticResource CalmCardStyle}">
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="16" />
    </Style>
</ResourceDictionary>
